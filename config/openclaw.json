{
  "models": {
    "defaultModel": "ollama/llama3:8b",
    "providers": {
      "ollama": {
        "enabled": true,
        "baseUrl": "${env.OLLAMA_BASE_URL}"
      },
      "openai": {
        "enabled": false,
        "apiKey": "${env.OPENAI_API_KEY}"
      },
      "anthropic": {
        "enabled": false,
        "apiKey": "${env.ANTHROPIC_API_KEY}"
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true,
        "package": "@openclaw/plugin-telegram",
        "config": {
          "botToken": "${env.TELEGRAM_BOT_TOKEN}"
        }
      }
    }
  },
  "tools": {
    "web_search": {
      "enabled": true,
      "provider": "duckduckgo"
    },
    "web_fetch": {
      "enabled": true
    },
    "memory": {
      "enabled": true,
      "persistDir": "${env.OPENCLAW_DATA_DIR}/memory"
    }
  },
  "standingOrders": [
    {
      "name": "trigger-user-onboarding",
      "description": "Run onboarding for any user who has not been profiled yet",
      "condition": "memory.user_profile_{{user.id}} does not exist",
      "skill": "user-onboarding",
      "priority": 1
    }
  ],
  "cron": [
    {
      "name": "nightly-tech-brief",
      "description": "Send the personalised daily tech brief at 9 PM in the user's timezone",
      "schedule": "0 21 * * *",
      "timezone": "${env.DEFAULT_CRON_TIMEZONE}",
      "session": "isolated",
      "channel": "telegram",
      "announce": true,
      "message": "Run the daily-quiz skill for the primary user. Retrieve their stored profile and generate and send the daily tech brief to them on Telegram."
    }
  ],
  "skills": {
    "dir": "${env.OPENCLAW_SKILLS_DIR}"
  },
  "logging": {
    "level": "${env.LOG_LEVEL}"
  }
}
