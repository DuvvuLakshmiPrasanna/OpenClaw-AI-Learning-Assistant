# OpenClaw Personalized Learning Assistant environment variables

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Local Ollama endpoint used by Docker Compose
OLLAMA_BASE_URL=http://ollama:11434

# Optional cloud providers
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# OpenClaw runtime paths
OPENCLAW_DATA_DIR=/app/data
OPENCLAW_SKILLS_DIR=/app/skills

# Default timezone for the nightly cron job
DEFAULT_CRON_TIMEZONE=UTC

# Logging
LOG_LEVEL=info
